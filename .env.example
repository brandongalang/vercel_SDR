# InstantDB public app identifier; all database operations stay server-only.
NEXT_PUBLIC_INSTANT_APP_ID=

# Server-only — required for /api/jobs/run to write jobs + pipeline audits
INSTANT_ADMIN_TOKEN=

# Also used by scripts/seed.ts and scripts/export-dspy-dataset.ts for local admin access

# OpenRouter, server-only. Primary: qwen/qwen3.8-27b:free.
# Requests enforce zero prompt, completion, and per-request prices.
# Selected fallbacks: nvidia/nemotron-3-ultra-550b-a55b:free, thinkingmachines/inkling:free.
# Live lead fallback is blocked: both prohibit personal/confidential data;
# Inkling also requires an agentic harness. See README for trusted synthetic tests.
# No paid fallback or environment switch to bypass data eligibility is enabled.
OPENROUTER_API_KEY=

# Tavily, server-only. Search requires the free Researcher plan (1000 credits/month)
# with pay-as-you-go disabled (paygo_limit=0). Usage is checked before every search;
# exhausted, paid, unknown, or unconfigured accounts stop without another provider.
# Set this only after the account/key setup is approved and completed by its owner.
TAVILY_API_KEY=

# Shared prototype gate, server-only. Owner enters values directly in Vercel.
APP_PASSWORD=
# Independent random value of at least 32 bytes, generated by its owner.
APP_SESSION_SECRET=

# Optional: Reset Demo button → POST /api/reset-demo (requires Instant admin + snapshot seed)
# Server: flip the switch and set a shared secret.
# ENABLE_DEMO_RESET=true
# DEMO_RESET_TOKEN=choose-a-long-random-string
# Keep browser demo reset disabled; never expose the reset token as a NEXT_PUBLIC value.
