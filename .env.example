# InstantDB (browser + server)
NEXT_PUBLIC_INSTANT_APP_ID=

# Server-only — required for /api/jobs/run to write jobs + pipeline audits
INSTANT_ADMIN_TOKEN=

# Also used by scripts/seed.ts and scripts/export-dspy-dataset.ts for local admin access

# Google Vertex AI — pick ONE auth path for production (Vercel has no default ADC):

# Option A — API key (Gemini on Vertex “express”; simplest on Vercel)
# GOOGLE_VERTEX_API_KEY=

# Option B — Service account JSON as a single line (paste full JSON from GCP)
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Optional overrides (defaults exist in lib/ai/vertex.ts)
# GOOGLE_VERTEX_PROJECT=
# GOOGLE_VERTEX_LOCATION=
# Optional override for Gemini Google Search fallback model
# GOOGLE_SEARCH_MODEL=gemini-2.5-flash

# Optional: Exa web search in research tools
# EXA_API_KEY=

# Optional: demo reset route controls
# ENABLE_DEMO_RESET=false
# DEMO_RESET_TOKEN=
